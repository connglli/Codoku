// EXPECT: FAIL:UndefinedBehavior
// SKIP: WASM
// SPEC v0.2.3 §7.5 rule 27
// Intention: a callee lets a pointer to its own local escape through a
// ptr-ptr out-parameter. The local dies with the activation, so loading
// through the escaped pointer after the callee returns has no live object
// behind it.
fun @escape(%out: ptr ptr i32) : i32 {
  let mut %local: i32 = 777;
^entry:
  store %out, addr %local;
  ret 0;
}

fun @main() : i32 {
  let mut %p: ptr i32 = null;
  let mut %pp: ptr ptr i32 = undef;
  let mut %r: i32 = 0;
^entry:
  %pp = addr %p;
  %r = call @escape(%pp);
  %r = load %p;
  ret %r;
}
