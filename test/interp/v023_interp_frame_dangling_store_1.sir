// EXPECT: FAIL:UndefinedBehavior
// SKIP: COMPILER, SOLVER
// SPEC v0.2.3 §7.5 rule 27
// Intention: as the load case, but writing through the escaped pointer.
// A store into a dead activation's local has nowhere to land.
fun @escape(%out: ptr ptr i32) : i32 {
  let mut %local: i32 = 777;
^entry:
  store %out, addr %local;
  ret 0;
}

fun @main() : i32 {
  let mut %p: ptr i32 = null;
  let mut %pp: ptr ptr i32 = undef;
  let mut %r: i32 = 0;
^entry:
  %pp = addr %p;
  %r = call @escape(%pp);
  store %p, 5;
  ret %r;
}
