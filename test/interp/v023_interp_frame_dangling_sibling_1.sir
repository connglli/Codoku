// EXPECT: FAIL:UndefinedBehavior
// SKIP: WASM, PYTHON
// SPEC v0.2.3 §7.5 rule 27
// Intention: a second call runs between the escape and the dereference, so
// the dead local's storage is no longer even the most recent thing at that
// depth. The read must fault rather than report whichever frame last sat
// there.
fun @escape(%out: ptr ptr i32) : i32 {
  let mut %local: i32 = 111;
^entry:
  store %out, addr %local;
  ret 0;
}

fun @sibling(%k: i32) : i32 {
  let mut %other: i32 = 222;
^entry:
  %other = %other + %k;
  ret %other;
}

fun @main() : i32 {
  let mut %p: ptr i32 = null;
  let mut %pp: ptr ptr i32 = undef;
  let mut %r: i32 = 0;
^entry:
  %pp = addr %p;
  %r = call @escape(%pp);
  %r = call @sibling(1);
  %r = load %p;
  ret %r;
}
