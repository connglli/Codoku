// EXPECT: FAIL:UndefinedBehavior
// SKIP: WASM
// SPEC v0.2.3 §7.5 rule 27
// Intention: the escaping pointer names a field of a callee-local struct,
// which the memory model tracks as its own object beside the whole-struct
// one. Both die with the activation, so the per-field object must go too.
struct @Pair {
  f0: i32;
  f1: i32;
}

fun @escape(%out: ptr ptr i32) : i32 {
  let mut %s: @Pair = {5, 9};
  let mut %sp: ptr @Pair = undef;
  let mut %fp: ptr i32 = null;
^entry:
  %sp = addr %s;
  %fp = ptrfield %sp, f1;
  store %out, %fp;
  ret 0;
}

fun @main() : i32 {
  let mut %p: ptr i32 = null;
  let mut %pp: ptr ptr i32 = undef;
  let mut %r: i32 = 0;
^entry:
  %pp = addr %p;
  %r = call @escape(%pp);
  %r = load %p;
  ret %r;
}
