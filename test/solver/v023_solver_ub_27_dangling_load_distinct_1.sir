// EXPECT: FAIL:UndefinedBehavior
// SKIP: COMPILER — C neither traps nor reliably detects the dangling read
// SOLVER_ARGS: --main @main --path ^entry,^exit
// SPEC v0.2.3 §7.5 rule 27
// Intention: the same escape with no name shared between the two frames, so
// the dead cell aliases nothing. The load is still UB — the pointer has no
// live object behind it whether or not anything else occupies its tag.
fun @escape(%out: ptr ptr i32) : i32 {
  let mut %callee_cell: i32 = 777;
^entry:
  store %out, addr %callee_cell;
  ret 0;
}

fun @main() : i32 {
  sym %?s0: value i32 in [1, 10];
  let mut %caller_cell: i32 = 5;
  let mut %p: ptr i32 = null;
  let mut %pp: ptr ptr i32 = undef;
  let mut %r: i32 = 0;
^entry:
  %caller_cell = %?s0;
  %pp = addr %p;
  %r = call @escape(%pp);
  %r = load %p;
  br ^exit;
^exit:
  ret %r;
}
