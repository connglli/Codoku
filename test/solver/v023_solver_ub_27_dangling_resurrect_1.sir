// EXPECT: FAIL:UndefinedBehavior
// SKIP: COMPILER — C neither traps nor reliably detects the dangling read
// SOLVER_ARGS: --main @main --path ^entry,^exit
// SPEC v0.2.3 §7.5 rule 27
// Intention: a second activation of the same callee runs before the read, so
// a live cell of exactly the escaped one's declaration exists again. It is a
// different activation and a different object, so the pointer from the first
// must not reach it — an identity a per-name tag cannot express.
fun @escape(%out: ptr ptr i32, %v: i32) : i32 {
  let mut %local: i32 = 0;
^entry:
  %local = %v;
  store %out, addr %local;
  ret 0;
}

fun @main() : i32 {
  sym %?s0: value i32 in [1, 10];
  let mut %p: ptr i32 = null;
  let mut %q: ptr i32 = null;
  let mut %pp: ptr ptr i32 = undef;
  let mut %qq: ptr ptr i32 = undef;
  let mut %r: i32 = 0;
^entry:
  %pp = addr %p;
  %qq = addr %q;
  %r = call @escape(%pp, %?s0);
  %r = call @escape(%qq, 42);
  %r = load %p;
  br ^exit;
^exit:
  ret %r;
}
