// EXPECT: FAIL:UndefinedBehavior
// SKIP: COMPILER — C neither traps nor reliably detects the dangling read
// SOLVER_ARGS: --main @main --path ^entry,^exit
// SPEC v0.2.3 §7.5 rule 27
// Intention: the escaping pointer names a field inside a callee-local struct,
// so its tag is an offset into the dead object rather than the object's own.
// Navigating and loading through it after the return is still UB.
struct @Pair {
  f0: i32;
  f1: i32;
}

fun @escape(%out: ptr ptr i32) : i32 {
  let mut %s: @Pair = {5, 777};
  let mut %sp: ptr @Pair = undef;
  let mut %fp: ptr i32 = null;
^entry:
  %sp = addr %s;
  %fp = ptrfield %sp, f1;
  store %out, %fp;
  ret 0;
}

fun @main() : i32 {
  sym %?s0: value i32 in [1, 10];
  let mut %s: @Pair = {0, 0};
  let mut %p: ptr i32 = null;
  let mut %pp: ptr ptr i32 = undef;
  let mut %r: i32 = 0;
^entry:
  %s.f1 = %?s0;
  %pp = addr %p;
  %r = call @escape(%pp);
  %r = load %p;
  br ^exit;
^exit:
  ret %r;
}
