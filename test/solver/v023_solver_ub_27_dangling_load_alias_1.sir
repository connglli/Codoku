// EXPECT: FAIL:UndefinedBehavior
// SKIP: COMPILER — C neither traps nor reliably detects the dangling read
// SOLVER_ARGS: --main @main --path ^entry,^exit
// SPEC v0.2.3 §7.5 rule 27
// Intention: the callee's local escapes through a ptr-ptr out-parameter and
// is read after the callee returned. The caller declares a local of the same
// name on purpose: a pointer tag derived from the name alone cannot tell the
// dead cell from the live one, and would resolve the load to the caller's.
fun @escape(%out: ptr ptr i32) : i32 {
  let mut %local: i32 = 777;
^entry:
  store %out, addr %local;
  ret 0;
}

fun @main() : i32 {
  sym %?s0: value i32 in [1, 10];
  let mut %local: i32 = 5;
  let mut %p: ptr i32 = null;
  let mut %pp: ptr ptr i32 = undef;
  let mut %r: i32 = 0;
^entry:
  %local = %?s0;
  %pp = addr %p;
  %r = call @escape(%pp);
  %r = load %p;
  br ^exit;
^exit:
  ret %r;
}
